# =================================================================
# CineWave — root .env template
#
# Copy to `.env` and fill in real values:  cp .env.example .env
# Generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# =================================================================

# ---- Host port mappings for docker-compose -----------------------
# Change these if the defaults collide with something else locally.
MYSQL_HOST_PORT=3307
REDIS_HOST_PORT=6380
KAFKA_HOST_PORT=9094
BACKEND_HOST_PORT=5000
FRONTEND_HOST_PORT=3000

# ---- Database ----------------------------------------------------
DB_USER=root
DB_PASSWORD=change_me
DB_NAME=MovieBookingDB

# ---- Secrets — required, no defaults in production ---------------
JWT_SECRET=
JWT_REFRESH_SECRET=
WEBHOOK_SECRET=
