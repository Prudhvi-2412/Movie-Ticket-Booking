# =================================================================
# CineWave backend — .env template
#
# Copy to `.env` and fill in real values:  cp .env.example .env
# Generate each secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# =================================================================

# ---- Server ------------------------------------------------------
PORT=5000
NODE_ENV=development
LOG_LEVEL=info
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- JWT — required, server refuses to boot in production without them
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ---- MySQL -------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=change_me
DB_NAME=MovieBookingDB

# ---- Redis (distributed seat locking) ----------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_PASSWORD=
# Seat hold duration in seconds. Drives both the Redis TTL and the UI timer.
SEAT_LOCK_TTL=600

# ---- Kafka -------------------------------------------------------
KAFKA_BROKERS=localhost:9094
KAFKA_CLIENT_ID=cinewave-backend

# ---- Payments / webhooks -----------------------------------------
# HMAC key the payment gateway signs webhook bodies with.
WEBHOOK_SECRET=

# ---- Booking economics -------------------------------------------
CONVENIENCE_FEE_PER_SEAT=20
GST_RATE=0.18

# ---- Razorpay ----------------------------------------------------
# Leave blank to use the built-in payment simulator (what CI and the test
# suite run against). Set both to switch to real Razorpay.
#   KEY_ID     public — sent to the browser to open Checkout
#   KEY_SECRET signs the Checkout callback. Never leaves the server
#   WEBHOOK_SECRET  set in the Razorpay dashboard; signs webhook bodies.
#                   Not the same value as KEY_SECRET.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
