{
  "name": "movie-ticket-booking-backend",
  "version": "1.0.0",
  "description": "Distributed Movie Ticket Booking Platform Backend",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "db:reset": "node scripts/migrate.js && node scripts/seed.js --force",
    "db:setup": "node scripts/migrate.js && node scripts/seed.js",
    "test": "jest --runInBand --detectOpenHandles --forceExit",
    "verify": "node scripts/verifyFlow.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "joi": "^17.13.1",
    "jsonwebtoken": "^9.0.2",
    "kafkajs": "^2.2.4",
    "morgan": "^1.10.0",
    "mysql2": "^3.9.8",
    "node-cron": "^3.0.3",
    "prom-client": "^15.1.2",
    "razorpay": "^2.9.8",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "supertest": "^7.0.0"
  }
}
